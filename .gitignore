.DS_Store
.build/

# Xcode build output / derived data (incl. custom -derivedDataPath dirs)
DerivedData/
.derivedData*/
xcuserdata/
*.xcuserstate

# Build / diagnostic logs
*.log

# Local Claude Code working dir (scheduled-task locks, etc.)
.claude/

# Generated by XcodeGen from project.yml — never commit these.
*.xcodeproj
!project.yml
MediaDler/Info.plist
ShareExtension/Info.plist

# Signing / provisioning / secrets — never commit private material.
*.mobileprovision
*.provisionprofile
*.p12
*.pfx
*.cer
*.certSigningRequest
*.keychain
*.keychain-db
*.pem
*.key
*.p8
ExportOptions.plist
